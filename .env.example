# ==============================================================================
# TatildeBugun - Örnek Çevre Değişkenleri (.env.example)
# Bu dosya şablondur. Gerçek gizli anahtarları .env.local dosyasına giriniz.
# ==============================================================================

# Veritabanı (Google Cloud SQL PostgreSQL)
DATABASE_URL="postgresql://kullanici:sifre@localhost:5432/tatildebugun?sslmode=require"

# NextAuth.js v5 Yapılandırması
AUTH_SECRET="ornek_auth_secret_en_az_32_karakterlik_guclu_rastgele_metin"
NEXTAUTH_URL="http://localhost:3006"

# Uygulama Ayarları
NEXT_PUBLIC_APP_URL="http://localhost:3006"
NEXT_PUBLIC_APP_NAME="TatildeBugün"

# E-posta Servisi (Resend)
RESEND_API_KEY="re_ornek_resend_api_key"
EMAIL_SENDER="admin@bugunai.com"

